# ── SECURITY & CRON SECRETS (Mandatory for /api/pipeline/run) ─────────────────
# Generated secret used by Vercel Cron and curl automation.
# Vercel sends: Authorization: Bearer <CRON_SECRET>
CRON_SECRET=your_long_random_cron_secret_here

# ── BOOTSTRAP ROLES (Server-Only) ─────────────────────────────────────────────
# Comma-separated list of emails that automatically receive 'admin' role on first signup/auth.
BOOTSTRAP_ADMIN_EMAILS=tanaythapar@example.com,sanvi850@example.com,panchadip125@example.com

# ── DATABASE & PERSISTENCE (Supabase / Self-Hosted PostgreSQL) ───────────────
# Supabase project URL and service role key (SERVER ONLY, never in NEXT_PUBLIC_*).
# Free tier limits: 500 MB DB storage, 50,000 MAU, 2 GB egress. Daily cron prevents project pause.
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Client-facing Supabase config (optional for browser auth)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# ── LOCAL DEMO SANDBOX ────────────────────────────────────────────────────────
# STRICT SECURITY: Active ONLY when NEXT_PUBLIC_DEMO_MODE=true AND NODE_ENV !== 'production'.
# Fails closed in production. Demo mode never grants admin/pipeline privileges.
NEXT_PUBLIC_DEMO_MODE=false

# ── AI ASSISTED DISCOVERY (Problem 6, Default Off) ────────────────────────────
# AI assists with deadline extraction and classification. Never auto-publishes.
# Free, open-source, self-hostable model (e.g. Ollama or local OpenAI-compatible endpoint).
AI_ENABLED=false
AI_API_BASE_URL=http://localhost:11434/v1
AI_MODEL=llama3.2
PIPELINE_INTERVAL=0 2 * * *

# ── SMTP NOTIFICATION DIGEST (Problem 7) ─────────────────────────────────────
# Standard SMTP credentials for email digest notifications.
# Self-hostable mail server (e.g. Postfix, Stalwart) or any SMTP account.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=notifications@example.com
SMTP_PASS=your_smtp_password
SMTP_FROM=TechRadar Updates <notifications@example.com>
NEXT_PUBLIC_APP_URL=https://tech-opportunity-tracker.vercel.app
